+	// Таймер простоя сбрасывают только входящие пакеты, поэтому мёртвый клиент всё равно отвалится.
+	if ka := icstats.EnvSeconds("XRAY_IC_QUIC_KEEPALIVE", 10); ka > 0 {
+		quicConfig.KeepAlivePeriod = time.Duration(ka) * time.Second
+	}
