+package icstats
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+func TestMetricsFormat(t *testing.T) {
+	UserSessionsRevoked.Store(3)
+	defer UserSessionsRevoked.Store(0)
+	rec := httptest.NewRecorder()
+	metricsHandler().ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/metrics", nil))
+	body := rec.Body.String()
+	if rec.Code != 200 || !strings.Contains(rec.Header().Get("Content-Type"), "version=0.0.4") {
+		t.Fatalf("code %d type %q", rec.Code, rec.Header().Get("Content-Type"))
+	}
+	for _, want := range []string{
+		"# TYPE infinity_user_sessions_revoked_total counter\n",
+		"infinity_user_sessions_revoked_total 3\n",
+		"# TYPE infinity_mux_workers_active gauge\n",
+	} {
+		if !strings.Contains(body, want) {
+			t.Errorf("missing %q", want)
+		}
+	}
+	seen := map[string]bool{}
+	for _, m := range metrics {
+		if seen[m.name] {
+			t.Errorf("duplicate %s", m.name)
+		}
+		seen[m.name] = true
+	}
+}
+
+func TestMetricsOnlyOnItsPath(t *testing.T) {
+	rec := httptest.NewRecorder()
+	metricsHandler().ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/debug/pprof/", nil))
+	if rec.Code != http.StatusNotFound {
+		t.Fatalf("code %d", rec.Code)
+	}
+}
