+package icstats
+
+import (
+	"errors"
+	"sync"
+	"testing"
+	"time"
+)
+
+func resetMuxWrites() {
+	MuxWritesActive.Store(0)
+	MuxWritesTotal.Store(0)
+	MuxWritesSlow.Store(0)
+	MuxWriteErrors.Store(0)
+	MuxWriteMaxNS.Store(0)
+}
+
+func TestMuxWriteThresholds(t *testing.T) {
+	resetMuxWrites()
+	defer resetMuxWrites()
+	for _, elapsed := range []time.Duration{time.Second - 1, time.Second, 2 * time.Second} {
+		MuxWritesActive.Add(1)
+		FinishMuxWrite(elapsed, nil)
+	}
+	MuxWritesActive.Add(1)
+	FinishMuxWrite(time.Millisecond, errors.New("ошибка записи"))
+	if MuxWritesActive.Load() != 0 || MuxWritesTotal.Load() != 4 || MuxWritesSlow.Load() != 2 || MuxWriteErrors.Load() != 1 || MuxWriteMaxNS.Load() != int64(2*time.Second) {
+		t.Fatal("неверные счётчики записи или граница медленной записи")
+	}
+}
+
+func TestMuxWriteConcurrent(t *testing.T) {
+	resetMuxWrites()
+	defer resetMuxWrites()
+	var group sync.WaitGroup
+	for i := 1; i <= 100; i++ {
+		group.Add(1)
+		go func(i int) {
+			defer group.Done()
+			MuxWritesActive.Add(1)
+			FinishMuxWrite(time.Duration(i)*time.Second, nil)
+		}(i)
+	}
+	group.Wait()
+	if MuxWritesActive.Load() != 0 || MuxWritesTotal.Load() != 100 || MuxWritesSlow.Load() != 100 || MuxWriteMaxNS.Load() != int64(100*time.Second) {
+		t.Fatal("параллельные записи потеряли счётчик или максимум")
+	}
+}
diff --git a/common/icusers/freelist.go b/common/icusers/freelist.go
