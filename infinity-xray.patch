--- /dev/null
+++ b/transport/internet/splithttp/h2flow_compete_controller_test.go
@@ -0,0 +1,61 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+// Проверяется весь цикл: PI и дополнительное ограничение длинной очереди.
+func TestFlowCompeteFullController(t *testing.T) {
+	for _, tc := range []struct {
+		name       string
+		enabled    bool
+		sibling    bool
+		start      int32
+		foreign    bool
+		wantGrowth bool
+	}{
+		{"foreign queue at floor", true, false, h2InitWindow, false, true},
+		{"own queue still shrinks", true, false, 1 << 20, false, false},
+		{"disabled still shrinks", false, false, 1 << 20, true, false},
+		{"sibling clears foreign state", true, true, 2 * h2InitWindow, true, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			old := flowCompete
+			flowCompete = tc.enabled
+			t.Cleanup(func() { flowCompete = old })
+			h, s := queuedDownload(t)
+			now := time.Unix(1000, 0)
+			h.c.mu.Lock()
+			defer h.c.mu.Unlock()
+			h.c.incremental = true
+			h.c.kstat = tcpStats{rtt: 600 * time.Millisecond, minRTT: 80 * time.Millisecond}
+			h.c.rttBase = h.c.kstat.minRTT
+			h.c.peers = joinFlowGroup("controller-test:" + t.Name())
+			h.c.peers.peers = map[*flowConn]*flowPeerRate{
+				h.c: {at: now, rate: 1 << 20, rated: now},
+			}
+			if tc.sibling {
+				h.c.peers.peers[&flowConn{}] = &flowPeerRate{at: now, rate: 1 << 20, rated: now}
+			}
+			s.down.cap, s.down.foreign = tc.start, tc.foreign
+			s.down.flat = flowFullRounds
+			s.down.mark, s.down.markBase = now.Add(-h.c.kstat.rtt), s.down.returned
+			s.down.returned += int64(tc.start)
+			h.c.governDown(now, s)
+			if tc.wantGrowth {
+				if !s.down.foreign || !s.down.competing {
+					t.Fatal("чужая очередь не распознана: неверные условия теста")
+				}
+				if s.down.cap <= tc.start {
+					t.Fatalf("после полного цикла окно %d не выросло от %d", s.down.cap, tc.start)
+				}
+			} else if s.down.cap >= tc.start {
+				t.Fatalf("защита собственной очереди не уменьшила окно %d: %d", tc.start, s.down.cap)
+			}
+			if tc.sibling && s.down.foreign {
+				t.Fatal("после появления второй загрузки остался признак чужой очереди")
+			}
+		})
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_compete_test.go b/transport/internet/splithttp/h2flow_compete_test.go
new file mode 100644
index 0000000..17ce23a
--- /dev/null
+++ b/transport/internet/splithttp/h2flow_compete_test.go
@@ -0,0 +1,85 @@
+package splithttp
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFlowCompete(t *testing.T) {
+	const ms = time.Millisecond
+	// A long foreign queue that cuts do not move: gain is low.
+	queue := tcpStats{rtt: 200 * ms, minRTT: 100 * ms}
+	competing := false
+	round := func(gain float64, copied int64, st tcpStats) int32 {
+		w := flowWindow{cap: 1 << 20, mark: time.Unix(0, 0), competing: competing}
+		w.returned = copied
+		w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, gain, 0)
+		return w.cap
+	}
+
+	if c := round(0, 1<<20, queue); c > 1<<20 {
+		t.Fatalf("off: cap grew to %d", c)
+	}
+
+	competing = true
+	if c := round(0, 1<<20, queue); c < 1<<20+1<<17 {
+		t.Fatalf("on, foreign queue, full reader: cap %d", c)
+	}
+	// The queue is the server's own while cuts work: never override them.
+	if c := round(1, 1<<20, queue); c >= 1<<20 {
+		t.Fatalf("on, own queue: cap grew to %d", c)
+	}
+	// A reader that does not fill the cap has no use for more.
+	if c := round(0, 1<<16, queue); c >= 1<<20+1<<17 {
+		t.Fatalf("on, idle reader: cap grew to %d", c)
+	}
+}
+
+func TestFlowPeersDownloadsAlone(t *testing.T) {
+	g := joinFlowGroup("peer:test")
+	defer g.leave()
+	a, b := &flowConn{}, &flowConn{}
+	t0 := time.Unix(100, 0)
+	step := time.Second
+	if g.downloadsAlone(a, t0, 0) {
+		t.Fatal("a rate not known yet counts as alone")
+	}
+	if !g.downloadsAlone(a, t0.Add(step), 8<<20) {
+		t.Fatal("one download is alone")
+	}
+	g.downloadsAlone(b, t0, 0)
+	g.downloadsAlone(b, t0.Add(step), 1<<10)
+	if !g.downloadsAlone(a, t0.Add(step), 8<<20) {
+		t.Fatal("a request beside a download took the download for a sibling")
+	}
+	g.downloadsAlone(b, t0.Add(2*step), 8<<20)
+	if g.downloadsAlone(a, t0.Add(2*step), 16<<20) {
+		t.Fatal("two downloads from an address are not alone")
+	}
+	if !g.downloadsAlone(a, t0.Add(2*step+flowPeerFresh+time.Second), 48<<20) {
+		t.Fatal("a sibling that went quiet still counts")
+	}
+	g.downloadsAlone(b, t0.Add(10*step), 16<<20)
+	g.dropPeer(b)
+	if !g.downloadsAlone(a, t0.Add(10*step), 80<<20) {
+		t.Fatal("a closed sibling still counts")
+	}
+}
+
+// A cap the queue took to init before the gain fell has no cut left to judge.
+func TestFlowCompeteGrowsFromInit(t *testing.T) {
+	const ms = time.Millisecond
+	st := tcpStats{rtt: 600 * ms, minRTT: 40 * ms}
+	round := func(competing bool) int32 {
+		w := flowWindow{cap: h2InitWindow, mark: time.Unix(0, 0), competing: competing}
+		w.returned = h2InitWindow
+		w.pi(w.mark.Add(st.rtt), st, h2InitWindow, 1<<30, 1, 0)
+		return w.cap
+	}
+	if c := round(false); c != h2InitWindow {
+		t.Fatalf("off: cap %d", c)
+	}
+	if c := round(true); c <= h2InitWindow {
+		t.Fatalf("on: cap %d stayed at init", c)
+	}
+}
diff --git a/transport/internet/splithttp/h2flow_config_test.go b/transport/internet/splithttp/h2flow_config_test.go
