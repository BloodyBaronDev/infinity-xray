new file mode 100644
index 0000000..040fc3e
--- /dev/null
+++ b/common/mux/ic_write_test.go
@@ -0,0 +1,76 @@
+package mux
+
+import (
+	"errors"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/icstats"
+)
+
+type icBlockingWriter struct {
+	entered chan buf.MultiBuffer
+	release chan struct{}
+	err     error
+}
+
+func (w *icBlockingWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	w.entered <- mb
+	<-w.release
+	buf.ReleaseMulti(mb)
+	return w.err
+}
+
+func TestICWriteDiagnostics(t *testing.T) {
+	for _, failure := range []error{nil, errors.New("ошибка downlink")} {
+		t.Run(fmtError(failure), func(t *testing.T) {
+			beforeActive := icstats.MuxWritesActive.Load()
+			beforeTotal := icstats.MuxWritesTotal.Load()
+			beforeErrors := icstats.MuxWriteErrors.Load()
+			sink := &icBlockingWriter{entered: make(chan buf.MultiBuffer, 1), release: make(chan struct{}), err: failure}
+			defer close(sink.release)
+			var last atomic.Int64
+			writer := &activityWriter{Writer: sink, last: &last}
+			payload := buf.New()
+			payload.WriteString("проверка")
+			result := make(chan error, 1)
+			go func() { result <- writer.WriteMultiBuffer(buf.MultiBuffer{payload}) }()
+			select {
+			case received := <-sink.entered:
+				if len(received) != 1 || received[0] != payload || received[0].String() != "проверка" {
+					t.Fatal("изменились данные записи")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("запись не началась")
+			}
+			if icstats.MuxWritesActive.Load() != beforeActive+1 || icstats.MuxWritesTotal.Load() != beforeTotal || last.Load() == 0 {
+				t.Fatal("незавершённая запись не видна в диагностике")
+			}
+			sink.release <- struct{}{}
+			select {
+			case err := <-result:
+				if err != failure {
+					t.Fatal("изменена ошибка нижележащего writer")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("запись не завершилась")
+			}
+			wantErrors := beforeErrors
+			if failure != nil {
+				wantErrors++
+			}
+			if icstats.MuxWritesActive.Load() != beforeActive || icstats.MuxWritesTotal.Load() != beforeTotal+1 || icstats.MuxWriteErrors.Load() != wantErrors {
+				t.Fatal("результат записи не учтён")
+			}
+		})
+	}
+}
+
+func fmtError(err error) string {
+	if err == nil {
+		return "success"
+	}
+	return "failure"
+}
