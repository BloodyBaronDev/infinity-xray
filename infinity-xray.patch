diff --git a/common/icstats/icstats.go b/common/icstats/icstats.go
new file mode 100644
index 0000000..822b6a1
--- /dev/null
+++ b/common/icstats/icstats.go
@@ -0,0 +1,79 @@
+// Package icstats — счётчики IC-форка. Раз в минуту пишет сводку в лог (уровень Warning),
+// чтобы видеть поведение keepalive и обрывов у реальных пользователей без debug-логов.
+package icstats
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strconv"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+var (
+	// Hysteria
+	HyConnsActive atomic.Int64 // открытые QUIC-соединения
+	HyConnsTotal  atomic.Int64 // принято за всё время
+	HyCloseIdle   atomic.Int64 // закрыто по таймауту простоя QUIC
+	HyCloseOther  atomic.Int64 // закрыто по другим причинам
+
+	// Mux (keepalive для XHTTP через CDN)
+	MuxWorkersActive atomic.Int64 // живые mux-соединения
+	MuxWorkersTotal  atomic.Int64 // создано за всё время
+	MuxSessionsTotal atomic.Int64 // подсоединений внутри mux
+	MuxKeepAlives    atomic.Int64 // отправлено keepalive-кадров
+	MuxKeepAliveErr  atomic.Int64 // keepalive не записался (соединение уже мертво)
+
+	MuxWritesActive atomic.Int64 // записи, ещё не вернувшиеся из downlink
+	MuxWritesTotal  atomic.Int64 // завершённые попытки записи, включая ошибки
+	MuxWritesSlow   atomic.Int64 // завершённые записи длительностью не менее секунды
+	MuxWriteErrors  atomic.Int64 // ошибки записи; причина обрыва из них не следует
+	MuxWriteMaxNS   atomic.Int64 // максимальная длительность записи с запуска
+)
+
+// FinishMuxWrite учитывает результат записи без адресов, пользователей и содержимого.
+func FinishMuxWrite(elapsed time.Duration, err error) {
+	MuxWritesActive.Add(-1)
+	MuxWritesTotal.Add(1)
+	if err != nil {
+		MuxWriteErrors.Add(1)
+	}
+	if elapsed >= time.Second {
+		MuxWritesSlow.Add(1)
+	}
+	for previous := MuxWriteMaxNS.Load(); int64(elapsed) > previous; previous = MuxWriteMaxNS.Load() {
+		if MuxWriteMaxNS.CompareAndSwap(previous, int64(elapsed)) {
+			break
+		}
+	}
+}
+
+// EnvSeconds читает интервал в секундах из окружения; при ошибке — def.
+func EnvSeconds(name string, def int) int {
+	if v, err := strconv.Atoi(os.Getenv(name)); err == nil {
+		return v
+	}
+	return def
+}
+
+func init() {
+	sec := EnvSeconds("XRAY_IC_STATS", 60)
+	if sec <= 0 {
+		return
+	}
+	go func() {
+		for range time.Tick(time.Duration(sec) * time.Second) {
+			if HyConnsTotal.Load() == 0 && MuxWorkersTotal.Load() == 0 {
+				continue
+			}
+			errors.LogWarning(context.Background(), fmt.Sprintf(
+				"[icstats] hy active=%d total=%d close_idle=%d close_other=%d | mux active=%d total=%d sessions=%d keepalives=%d ka_err=%d | mux_write active=%d total=%d slow=%d err=%d max_ms=%d",
+				HyConnsActive.Load(), HyConnsTotal.Load(), HyCloseIdle.Load(), HyCloseOther.Load(),
+				MuxWorkersActive.Load(), MuxWorkersTotal.Load(), MuxSessionsTotal.Load(), MuxKeepAlives.Load(), MuxKeepAliveErr.Load(),
+				MuxWritesActive.Load(), MuxWritesTotal.Load(), MuxWritesSlow.Load(), MuxWriteErrors.Load(), MuxWriteMaxNS.Load()/int64(time.Millisecond)))
+		}
+	}()
+}
diff --git a/common/icstats/metrics.go b/common/icstats/metrics.go
new file mode 100644
index 0000000..c4736ca
--- /dev/null
+++ b/common/icstats/metrics.go
@@ -0,0 +1,106 @@
+package icstats
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+var (
+	// Inbound and shutdown
+	InboundConnsActive atomic.Int64 // connections inside an inbound handler
+	Draining           atomic.Int64 // 1 from the stop signal on
+
+	// Per-user policy
+	UserConnsRejected   atomic.Int64
+	UserSessionsRevoked atomic.Int64
+	UserRateWaits       atomic.Int64
+
+	// HTTP/2 governor
+	H2FlowConnsActive atomic.Int64
+	H2FlowConnsTotal  atomic.Int64
+	H2FlowCompete     atomic.Int64 // rounds a window grew against a foreign queue
+)
+
+type metric struct {
+	name, kind, help string
+	value            func() float64
+}
+
+func counter(name, help string, v *atomic.Int64) metric {
+	return metric{name, "counter", help, func() float64 { return float64(v.Load()) }}
+}
+
+func gauge(name, help string, v *atomic.Int64) metric {
+	return metric{name, "gauge", help, func() float64 { return float64(v.Load()) }}
+}
+
+var metrics = []metric{
+	gauge("infinity_hysteria_conns_active", "Open Hysteria QUIC connections.", &HyConnsActive),
+	counter("infinity_hysteria_conns_total", "Accepted Hysteria QUIC connections.", &HyConnsTotal),
+	counter("infinity_hysteria_close_idle_total", "Hysteria connections closed by QUIC idle timeout.", &HyCloseIdle),
+	counter("infinity_hysteria_close_other_total", "Hysteria connections closed for other reasons.", &HyCloseOther),
+	gauge("infinity_mux_workers_active", "Live mux connections.", &MuxWorkersActive),
+	counter("infinity_mux_workers_total", "Created mux connections.", &MuxWorkersTotal),
+	counter("infinity_mux_sessions_total", "Sub-connections inside mux.", &MuxSessionsTotal),
+	counter("infinity_mux_keepalives_total", "Sent mux keepalive frames.", &MuxKeepAlives),
+	counter("infinity_mux_keepalive_errors_total", "Mux keepalive frames that failed to write.", &MuxKeepAliveErr),
+	gauge("infinity_mux_writes_active", "Mux writes not yet returned.", &MuxWritesActive),
+	counter("infinity_mux_writes_total", "Finished mux write attempts, including errors.", &MuxWritesTotal),
+	counter("infinity_mux_writes_slow_total", "Finished mux writes of at least a second.", &MuxWritesSlow),
+	counter("infinity_mux_write_errors_total", "Mux write errors.", &MuxWriteErrors),
+	{"infinity_mux_write_max_seconds", "gauge", "Longest finished mux write since start.", func() float64 {
+		return time.Duration(MuxWriteMaxNS.Load()).Seconds()
+	}},
+	gauge("infinity_inbound_conns_active", "Connections inside inbound handlers.", &InboundConnsActive),
+	gauge("infinity_draining", "1 once the process stopped accepting connections.", &Draining),
+	counter("infinity_user_conns_rejected_total", "Connections rejected by the per-user limit.", &UserConnsRejected),
+	counter("infinity_user_sessions_revoked_total", "Sessions closed because their user was removed.", &UserSessionsRevoked),
+	counter("infinity_user_rate_waits_total", "Transfers delayed by the per-user rate limit.", &UserRateWaits),
+	gauge("infinity_h2flow_conns_active", "Server connections under the HTTP/2 governor.", &H2FlowConnsActive),
+	counter("infinity_h2flow_conns_total", "Server connections accepted under the HTTP/2 governor.", &H2FlowConnsTotal),
+	counter("infinity_h2flow_compete_rounds_total", "Rounds a window grew against a foreign queue.", &H2FlowCompete),
+}
+
+// WriteMetrics writes the Prometheus text format. Only aggregates: no user,
+// address or traffic content ever reaches it.
+func WriteMetrics(w io.Writer) error {
+	for _, m := range metrics {
+		if _, err := fmt.Fprintf(w, "# HELP %s %s\n# TYPE %s %s\n%s %g\n", m.name, m.help, m.name, m.kind, m.name, m.value()); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func metricsHandler() http.Handler {
+	mux := http.NewServeMux()
+	mux.HandleFunc("/metrics", func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "text/plain; version=0.0.4; charset=utf-8")
+		_ = WriteMetrics(w)
+	})
+	return mux
+}
+
+// StartMetrics serves /metrics on XRAY_IC_METRICS_LISTEN; unset leaves it off.
+// A bad address is logged and never stops the proxy.
+func StartMetrics() {
+	addr := os.Getenv("XRAY_IC_METRICS_LISTEN")
+	if addr == "" {
+		return
+	}
+	l, err := net.Listen("tcp", addr)
+	if err != nil {
+		errors.LogWarning(context.Background(), "[icstats] metrics not started: ", err)
+		return
+	}
+	srv := &http.Server{Handler: metricsHandler(), ReadHeaderTimeout: 5 * time.Second}
+	go func() { _ = srv.Serve(l) }()
+}
