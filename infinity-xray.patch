index 0000000..d4f64a3
--- /dev/null
+++ b/common/icusers/freelist.go
@@ -0,0 +1,77 @@
+package icusers
+
+import (
+	"bufio"
+	"os"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+)
+
+// freeList — набор email бесплатных пользователей из файла, по строке на email.
+// Файл перечитывается при смене mtime/размера; пропавший или битый файл оставляет прежний набор.
+type freeList struct {
+	path  string
+	label string // подпись в логе: "free users", "unlimited users"
+	set   atomic.Pointer[map[string]struct{}]
+}
+
+var freeReload = 5 * time.Second
+
+func newFreeList(path string) *freeList {
+	return newUserList(path, "free users")
+}
+
+// newUserList — тот же файловый список email с другой подписью в логе.
+func newUserList(path, label string) *freeList {
+	if path == "" {
+		return nil
+	}
+	f := &freeList{path: path, label: label}
+	empty := map[string]struct{}{}
+	f.set.Store(&empty)
+	var mod time.Time
+	var size int64 = -1
+	mod, size = f.reload(mod, size)
+	go func() {
+		for range time.Tick(freeReload) {
+			mod, size = f.reload(mod, size)
+		}
+	}()
+	return f
+}
+
+func (f *freeList) reload(mod time.Time, size int64) (time.Time, int64) {
+	st, err := os.Stat(f.path)
+	if err != nil || (st.ModTime().Equal(mod) && st.Size() == size) {
+		return mod, size
+	}
+	file, err := os.Open(f.path)
+	if err != nil {
+		return mod, size
+	}
+	defer file.Close()
+	set := map[string]struct{}{}
+	sc := bufio.NewScanner(file)
+	for sc.Scan() {
+		if line := strings.TrimSpace(sc.Text()); line != "" && !strings.HasPrefix(line, "#") {
+			set[line] = struct{}{}
+		}
+	}
+	if sc.Err() != nil {
+		return mod, size
+	}
+	f.set.Store(&set)
+	errors.LogWarning(nil, "[icusers] ", f.label, ": ", len(set))
+	return st.ModTime(), st.Size()
+}
+
+func (f *freeList) has(email string) bool {
+	if f == nil {
+		return false
+	}
+	_, ok := (*f.set.Load())[email]
+	return ok
+}
