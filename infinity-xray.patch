+func TestXHTTPH2Flow(t *testing.T) {
+	build := func(s string) (*splithttp.Config, error) {
+		var c SplitHTTPConfig
+		if err := json.Unmarshal([]byte(s), &c); err != nil {
+			t.Fatal(err)
