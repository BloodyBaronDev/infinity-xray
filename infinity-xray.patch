+package reality
+
+import "testing"
+
+func TestCheckServerKeysAcceptsValidMaterial(t *testing.T) {
+	for _, length := range []int{8, 9} {
+		config := &Config{PrivateKey: make([]byte, 32), Mldsa65Seed: make([]byte, 32), ShortIds: [][]byte{make([]byte, length)}}
+		if err := config.CheckServerKeys(); err != nil {
+			t.Fatalf("valid keys and short ID of length %d: %v", length, err)
+		}
+	}
+}
