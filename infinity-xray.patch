+package tls
+
+import (
+	"bytes"
+	gotls "crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/protocol/tls/cert"
+	"google.golang.org/protobuf/proto"
+)
+
+func snapshotTestCertificate(t *testing.T, name string) *Certificate {
+	t.Helper()
+	generated, _ := cert.MustGenerate(nil, cert.CommonName(name), cert.DNSNames(name))
+	entry := ParseCertificate(generated)
+	entry.OneTimeLoading = true
+	return entry
+}
+
+func writeSnapshotPair(t *testing.T, entry *Certificate, certificate, key string) {
+	t.Helper()
+	if err := os.WriteFile(certificate, entry.Certificate, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(key, entry.Key, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestCertificateSourceKeepsLastValidPair(t *testing.T) {
+	first := snapshotTestCertificate(t, "first.test")
+	second := snapshotTestCertificate(t, "second.test")
+	directory := t.TempDir()
+	first.CertificatePath, first.KeyPath = filepath.Join(directory, "cert.pem"), filepath.Join(directory, "key.pem")
+	writeSnapshotPair(t, first, first.CertificatePath, first.KeyPath)
+	original := proto.Clone(first)
+	source := newCertificateSource(first)
+	defer source.close()
+	if err := os.WriteFile(first.CertificatePath, second.Certificate, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := source.reload(); err == nil || changed {
+		t.Fatalf("несовпадающая пара опубликована: changed=%v err=%v", changed, err)
+	}
+	if !bytes.Equal(source.load().Certificate, first.Certificate) {
+		t.Fatal("последний рабочий сертификат потерян")
+	}
+	if err := os.WriteFile(first.KeyPath, second.Key, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := source.reload(); err != nil || !changed {
+		t.Fatalf("новая корректная пара не загружена: changed=%v err=%v", changed, err)
+	}
+	if !bytes.Equal(source.load().Certificate, second.Certificate) || !proto.Equal(first, original) {
+		t.Fatal("обновление потеряно или изменило исходный proto-конфиг")
+	}
+	if err := os.Remove(first.CertificatePath); err != nil {
+		t.Fatal(err)
+	}
+	if changed, err := source.reload(); err == nil || changed {
+		t.Fatal("исчезнувший файл заменил рабочий снимок")
+	}
+	if !bytes.Equal(source.load().Certificate, second.Certificate) {
+		t.Fatal("ошибка чтения сбросила рабочий снимок")
+	}
+}
+
+func TestCertificateStoreHotReloadConcurrentSelection(t *testing.T) {
+	first := snapshotTestCertificate(t, "first.test")
+	second := snapshotTestCertificate(t, "second.test")
+	directory := t.TempDir()
+	first.CertificatePath, first.KeyPath = filepath.Join(directory, "cert.pem"), filepath.Join(directory, "key.pem")
+	first.OneTimeLoading, first.OcspStapling = false, 1
+	writeSnapshotPair(t, first, first.CertificatePath, first.KeyPath)
+	original := proto.Clone(first)
+	store := (&Config{Certificate: []*Certificate{first}}).buildCertificateStore()
+	defer store.close()
+	selectCertificate := getNewGetCertificateFunc(store, false)
+	old, err := selectCertificate(&gotls.ClientHelloInfo{ServerName: "first.test"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	stop := make(chan struct{})
+	var workers sync.WaitGroup
+	for range 8 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				certificate, err := selectCertificate(&gotls.ClientHelloInfo{ServerName: "first.test"})
+				if err != nil || certificate.Leaf == nil || len(certificate.Certificate) == 0 {
+					t.Error("выбор сертификата потерял целостный снимок")
+					return
+				}
+			}
+		}()
+	}
+	defer func() { close(stop); workers.Wait() }()
+	writeSnapshotPair(t, second, first.CertificatePath, first.KeyPath)
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		current, err := selectCertificate(&gotls.ClientHelloInfo{ServerName: "second.test"})
+		if err == nil && current.Leaf.Subject.CommonName == "second.test" {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("watcher не опубликовал новый сертификат")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	if old.Leaf.Subject.CommonName != "first.test" || !proto.Equal(first, original) {
+		t.Fatal("reload изменил опубликованный сертификат или исходный конфиг")
+	}
+}
+
+func TestCertificateIssuingKeepsTLSConfigImmutable(t *testing.T) {
+	generated, _ := cert.MustGenerate(nil, cert.Authority(true), cert.KeyUsage(x509.KeyUsageCertSign))
+	entry := ParseCertificate(generated)
+	entry.Usage, entry.OneTimeLoading = Certificate_AUTHORITY_ISSUE, true
+	tlsConfig := (&Config{Certificate: []*Certificate{entry}}).GetTLSConfig()
+	var workers sync.WaitGroup
+	for worker := range 8 {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			for request := range 12 {
+				certificate, err := tlsConfig.GetCertificate(&gotls.ClientHelloInfo{
+					ServerName: fmt.Sprintf("%d-%d.test", worker, request),
+				})
+				if err != nil || certificate.Leaf == nil {
+					t.Errorf("выдача сертификата: %v", err)
+					return
+				}
+				// crypto/tls читает эти поля параллельно с callback.
+				if len(tlsConfig.Certificates) != 0 || len(tlsConfig.NameToCertificate) != 0 {
+					t.Error("callback изменил общий tls.Config")
+					return
+				}
+			}
+		}()
+	}
+	workers.Wait()
+}
