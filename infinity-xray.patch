diff --git a/app/dispatcher/ic_rate.go b/app/dispatcher/ic_rate.go
new file mode 100644
index 0000000..0a5b1b8
--- /dev/null
+++ b/app/dispatcher/ic_rate.go
@@ -0,0 +1,62 @@
+package dispatcher
+
+import (
+	"context"
+
+	"github.com/xtls/xray-core/common"
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/icusers"
+)
+
+// rateWriter charges what it writes to a user's shared bucket.
+type rateWriter struct {
+	ctx    context.Context
+	bucket *icusers.Bucket
+	writer buf.Writer
+}
+
+func (w *rateWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	if err := w.bucket.Wait(w.ctx, int(mb.Len())); err != nil {
+		buf.ReleaseMulti(mb)
+		return err
+	}
+	return w.writer.WriteMultiBuffer(mb)
+}
+
+func (w *rateWriter) Close() error { return common.Close(w.writer) }
+
+func (w *rateWriter) Interrupt() { common.Interrupt(w.writer) }
+
+// rateReader charges what it read before handing it on.
+type rateReader struct {
+	ctx    context.Context
+	bucket *icusers.Bucket
+	reader buf.Reader
+}
+
+func (r *rateReader) ReadMultiBuffer() (buf.MultiBuffer, error) {
+	mb, err := r.reader.ReadMultiBuffer()
+	if !mb.IsEmpty() {
+		if waitErr := r.bucket.Wait(r.ctx, int(mb.Len())); waitErr != nil {
+			buf.ReleaseMulti(mb)
+			return nil, waitErr
+		}
+	}
+	return mb, err
+}
+
+func (r *rateReader) Interrupt() { common.Interrupt(r.reader) }
+
+func limitWriter(ctx context.Context, b *icusers.Bucket, w buf.Writer) buf.Writer {
+	if b == nil {
+		return w
+	}
+	return &rateWriter{ctx: ctx, bucket: b, writer: w}
+}
+
+func limitReader(ctx context.Context, b *icusers.Bucket, r buf.Reader) buf.Reader {
+	if b == nil {
+		return r
+	}
+	return &rateReader{ctx: ctx, bucket: b, reader: r}
+}
diff --git a/app/dispatcher/ic_rate_test.go b/app/dispatcher/ic_rate_test.go
new file mode 100644
index 0000000..c3cd125
--- /dev/null
+++ b/app/dispatcher/ic_rate_test.go
@@ -0,0 +1,63 @@
+package dispatcher
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+	"github.com/xtls/xray-core/common/icusers"
+)
+
+type sinkWriter struct{ n int32 }
+
+func (s *sinkWriter) WriteMultiBuffer(mb buf.MultiBuffer) error {
+	s.n += mb.Len()
+	buf.ReleaseMulti(mb)
+	return nil
+}
+
+func oneBuffer(size int32) buf.MultiBuffer {
+	b := buf.New()
+	b.Extend(size)
+	return buf.MultiBuffer{b}
+}
+
+func TestRateWriterPassesWithoutBucket(t *testing.T) {
+	sink := &sinkWriter{}
+	if limitWriter(context.Background(), nil, sink) != buf.Writer(sink) {
+		t.Fatal("unlimited user got a wrapper")
+	}
+}
+
+func TestRateWriterDelays(t *testing.T) {
+	sink := &sinkWriter{}
+	// 64 KiB burst at 64 KiB/s: the second second's data has to wait.
+	w := limitWriter(context.Background(), icusers.NewBucket(64*1024), sink)
+	start := time.Now()
+	for sent := 0; sent < 96*1024; sent += 2048 {
+		if err := w.WriteMultiBuffer(oneBuffer(2048)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if d := time.Since(start); d < 300*time.Millisecond {
+		t.Fatalf("not limited: %v", d)
+	}
+	if sink.n != 96*1024 {
+		t.Fatalf("delivered %d", sink.n)
+	}
+}
+
+func TestRateWriterStopsWithContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	w := limitWriter(ctx, icusers.NewBucket(1), &sinkWriter{})
+	_ = w.WriteMultiBuffer(oneBuffer(2048)) // inside the minimum burst
+	var err error
+	for i := 0; i < 64 && err == nil; i++ {
+		err = w.WriteMultiBuffer(oneBuffer(2048))
+	}
+	if err == nil {
+		t.Fatal("blocked writer ignored its context")
+	}
+}
