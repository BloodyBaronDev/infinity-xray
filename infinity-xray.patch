@@ -0,0 +1,52 @@
+package icusers
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestFreeListReloadAndBuckets(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "free.txt")
+	os.WriteFile(path, []byte("# бесплатные\n142\n 7 \n"), 0o644)
+	f := newFreeList(path)
+	if !f.has("142") || !f.has("7") || f.has("8") {
+		t.Fatal("список не прочитан")
+	}
+	// Перевод в платные: файл переписан, набор обновился.
+	os.WriteFile(path, []byte("7\n"), 0o644)
+	future := time.Now().Add(time.Minute)
+	os.Chtimes(path, future, future)
+	f.reload(time.Time{}, -1)
+	if f.has("142") || !f.has("7") {
+		t.Fatal("список не перечитан")
+	}
+	// Пропавший файл не сбрасывает набор.
+	os.Remove(path)
+	f.reload(time.Time{}, -1)
+	if !f.has("7") {
+		t.Fatal("набор потерян при пропаже файла")
+	}
+	var nilList *freeList
+	if nilList.has("7") {
+		t.Fatal("nil-список не пуст")
+	}
+
+	oldFree, oldList, oldDown := rateFree, freeUsers, rateDown
+	defer func() { rateFree, freeUsers, rateDown = oldFree, oldList, oldDown }()
+	rateFree, freeUsers, rateDown = 5e6/8, f, 13e6/8
+	if b := DownlinkBucket("7"); b == nil || b.rate != 5e6/8 {
+		t.Fatal("бесплатному не дан лимит бесплатных")
+	}
+	if b := DownlinkBucket("142"); b == nil || b.rate != 13e6/8 {
+		t.Fatal("платному не дан общий лимит")
+	}
+	rateDown = 0
+	if DownlinkBucket("143") != nil {
+		t.Fatal("платный без общего лимита должен быть без ведра")
+	}
+	if !RateLimited() {
+		t.Fatal("RateLimited должен учитывать лимит бесплатных")
+	}
+}
diff --git a/common/icusers/icusers.go b/common/icusers/icusers.go
new file mode 100644
index 0000000..166963b
--- /dev/null
+++ b/common/icusers/icusers.go
@@ -0,0 +1,290 @@
+// Package icusers holds per-user server policy of Infinity Xray: delayed
+// revocation of removed users, a connection limit and a shared rate limit.
+// Everything is off unless enabled through the environment at process start.
+package icusers
+
+import (
+	"context"
+	"os"
+	"sync"
+	"time"
+
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/icstats"
+	"github.com/xtls/xray-core/common/protocol"
+)
+
+var (
+	revokeGrace = time.Duration(icstats.EnvSeconds("XRAY_IC_REVOKE_GRACE", 0)) * time.Second
+	maxConns    = icstats.EnvSeconds("XRAY_IC_USER_MAX_CONNS", 0)
+)
+
+// ErrTooManyConns rejects a connection over XRAY_IC_USER_MAX_CONNS.
+var ErrTooManyConns = errors.New("user connection limit reached")
+
+// ErrRevoked rejects a connection authenticated just before its user's removal.
+var ErrRevoked = errors.New("user removed")
+
+// The limit spans inbounds: one person on two inbounds is still one user.
+var conns = struct {
+	sync.Mutex
+	n map[string]int
+}{n: make(map[string]int)}
+
+func acquireConn(email string, limit int) bool {
+	conns.Lock()
+	defer conns.Unlock()
+	if limit > 0 && conns.n[email] >= limit {
+		return false
+	}
+	conns.n[email]++
+	return true
+}
+
+func releaseConn(email string) {
+	conns.Lock()
+	defer conns.Unlock()
+	if conns.n[email]--; conns.n[email] <= 0 {
+		delete(conns.n, email)
+	}
+}
+
+type pendingRevoke struct {
+	timer   *time.Timer
+	account protocol.Account
+}
+
+// Tracker follows the live sessions of one inbound. Remnawave Node removes and
+// adds back unchanged users on every sync, so a removal only takes effect if
+// the same account has not returned within the grace period.
+type Tracker struct {
+	grace time.Duration
+	limit int
+
+	mu       sync.Mutex
+	nextID   uint64
+	sessions map[string]map[uint64]func()
+	pending  map[string]*pendingRevoke
+}
+
+// NewTracker returns a Tracker configured from the environment.
+func NewTracker() *Tracker {
+	return newTracker(revokeGrace, maxConns)
+}
+
+func newTracker(grace time.Duration, limit int) *Tracker {
+	return &Tracker{
+		grace:    grace,
+		limit:    limit,
+		sessions: make(map[string]map[uint64]func()),
+		pending:  make(map[string]*pendingRevoke),
+	}
+}
+
+// Acquire registers a session. closeFn must end it and may be called from any
+// goroutine. The returned release must be called exactly once.
+func (t *Tracker) Acquire(email string, closeFn func()) (release func(), err error) {
+	if email == "" || (t.grace <= 0 && t.limit <= 0) {
+		return func() {}, nil
+	}
+	if !acquireConn(email, t.limit) {
+		icstats.UserConnsRejected.Add(1)
+		return nil, ErrTooManyConns
+	}
+	t.mu.Lock()
+	t.nextID++
+	id := t.nextID
+	if t.sessions[email] == nil {
+		t.sessions[email] = make(map[uint64]func())
+	}
+	t.sessions[email][id] = closeFn
+	t.mu.Unlock()
+	return func() {
+		t.mu.Lock()
+		delete(t.sessions[email], id)
+		if len(t.sessions[email]) == 0 {
+			delete(t.sessions, email)
+		}
+		t.mu.Unlock()
+		releaseConn(email)
+	}, nil
+}
+
+// Removed starts the grace period of a user just removed from the inbound.
+func (t *Tracker) Removed(email string, account protocol.Account) {
+	if email == "" || t.grace <= 0 {
+		return
+	}
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if old := t.pending[email]; old != nil {
+		old.timer.Stop()
+	}
+	p := &pendingRevoke{account: account}
+	p.timer = time.AfterFunc(t.grace, func() { t.expire(email, p) })
+	t.pending[email] = p
+}
+
+// Added ends the grace period. Sessions survive only if the account is the
+// same one: a user returning with a new key must not keep the old key's.
+func (t *Tracker) Added(email string, account protocol.Account) {
+	if email == "" || t.grace <= 0 {
+		return
+	}
+	t.mu.Lock()
+	p := t.pending[email]
+	if p == nil {
+		t.mu.Unlock()
+		return
+	}
+	p.timer.Stop()
+	delete(t.pending, email)
+	var closers []func()
+	if p.account == nil || account == nil || !p.account.Equals(account) {
+		closers = t.closersLocked(email)
+	}
+	t.mu.Unlock()
+	runClosers(closers)
+}
+
+func (t *Tracker) expire(email string, p *pendingRevoke) {
+	t.mu.Lock()
+	if t.pending[email] != p { // came back or replaced while the timer fired
+		t.mu.Unlock()
+		return
+	}
+	delete(t.pending, email)
+	closers := t.closersLocked(email)
+	t.mu.Unlock()
+	runClosers(closers)
+}
+
+func (t *Tracker) closersLocked(email string) []func() {
+	closers := make([]func(), 0, len(t.sessions[email]))
+	for _, c := range t.sessions[email] {
+		closers = append(closers, c)
+	}
+	return closers
+}
+
+func runClosers(closers []func()) {
+	for _, c := range closers {
+		c()
+	}
+	if len(closers) > 0 {
+		icstats.UserSessionsRevoked.Add(int64(len(closers)))
+	}
+}
+
+// Close cancels pending revocations; sessions end with the inbound's owner.
+func (t *Tracker) Close() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	for email, p := range t.pending {
+		p.timer.Stop()
+		delete(t.pending, email)
+	}
+}
+
+// Enabled reports whether a removal can still reach a session being set up.
+func (t *Tracker) Enabled() bool {
+	return t.grace > 0
+}
+
+// Bucket is a token bucket that lets a transfer go into debt and then waits it
+// off, so buffers larger than the burst still pass.
+type Bucket struct {
+	mu     sync.Mutex
+	rate   float64
+	burst  float64
+	tokens float64
+	last   time.Time
+}
+
+// NewBucket allows bytesPerSecond with a quarter second of burst, at least 64 KiB.
+func NewBucket(bytesPerSecond float64) *Bucket {
+	burst := max(bytesPerSecond/4, 64*1024)
+	return &Bucket{rate: bytesPerSecond, burst: burst, tokens: burst, last: time.Now()}
+}
+
+// reserve takes n bytes and returns how long the caller owes.
+func (b *Bucket) reserve(now time.Time, n int) time.Duration {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	b.tokens = min(b.tokens+now.Sub(b.last).Seconds()*b.rate, b.burst) - float64(n)
+	b.last = now
+	if b.tokens >= 0 {
+		return 0
+	}
+	return time.Duration(-b.tokens / b.rate * float64(time.Second))
+}
+
+// Wait blocks until n bytes are allowed or ctx ends.
+func (b *Bucket) Wait(ctx context.Context, n int) error {
+	d := b.reserve(time.Now(), n)
+	if d <= 0 {
+		return nil
+	}
+	icstats.UserRateWaits.Add(1)
+	timer := time.NewTimer(d)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+		return nil
+	case <-ctx.Done():
+		return ctx.Err()
+	}
+}
+
+var (
+	rateUp   = float64(icstats.EnvSeconds("XRAY_IC_USER_RATE_UP_MBPS", 0)) * 1e6 / 8
+	rateDown = float64(icstats.EnvSeconds("XRAY_IC_USER_RATE_DOWN_MBPS", 0)) * 1e6 / 8
+	// Бесплатные: свой лимит в обе стороны для email из файла XRAY_IC_FREE_USERS_FILE.
+	rateFree  = float64(icstats.EnvSeconds("XRAY_IC_FREE_RATE_MBPS", 0)) * 1e6 / 8
+	freeUsers = newFreeList(os.Getenv("XRAY_IC_FREE_USERS_FILE"))
+	// Без лимита: email из файла XRAY_IC_UNLIMITED_USERS_FILE не получают ведро скорости.
+	unlimitedUsers = newUserList(os.Getenv("XRAY_IC_UNLIMITED_USERS_FILE"), "unlimited users")
+	buckets        sync.Map // "u"/"d" + "f"/"p" + email -> *Bucket
+)
+
+// RateLimited reports whether any user rate limit is on.
+func RateLimited() bool {
+	return rateUp > 0 || rateDown > 0 || (rateFree > 0 && freeUsers != nil)
+}
+
+// IsFree reports whether email is in the free users file.
+func IsFree(email string) bool {
+	return rateFree > 0 && freeUsers.has(email)
+}
+
+// IsUnlimited reports whether email is in the unlimited users file.
+func IsUnlimited(email string) bool {
+	return unlimitedUsers.has(email)
+}
+
+func bucketFor(prefix, email string, rate float64) *Bucket {
+	if email == "" || IsUnlimited(email) {
+		return nil
+	}
+	// Тариф входит в ключ: после смены тарифа новые соединения берут новое ведро.
+	if IsFree(email) {
+		prefix, rate = prefix+"f", rateFree
+	} else {
+		prefix += "p"
+	}
+	if rate <= 0 {
+		return nil
+	}
+	key := prefix + email
+	if b, ok := buckets.Load(key); ok {
+		return b.(*Bucket)
+	}
+	b, _ := buckets.LoadOrStore(key, NewBucket(rate))
+	return b.(*Bucket)
+}
+
+// UplinkBucket is the user's shared upload bucket, nil when unlimited.
+func UplinkBucket(email string) *Bucket { return bucketFor("u", email, rateUp) }
+
+// DownlinkBucket is the user's shared download bucket, nil when unlimited.
+func DownlinkBucket(email string) *Bucket { return bucketFor("d", email, rateDown) }
diff --git a/common/icusers/icusers_test.go b/common/icusers/icusers_test.go
new file mode 100644
index 0000000..d9f0dd3
--- /dev/null
+++ b/common/icusers/icusers_test.go
@@ -0,0 +1,134 @@
+package icusers
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/protocol"
+	"google.golang.org/protobuf/proto"
+)
+
+type testAccountStub string
+
+func (a testAccountStub) Equals(o protocol.Account) bool {
+	other, ok := o.(testAccountStub)
+	return ok && other == a
+}
+
+func (a testAccountStub) ToProto() proto.Message { return nil }
+
+func session(t *testing.T, tr *Tracker, email string) (*atomic.Int32, func()) {
+	t.Helper()
+	var closed atomic.Int32
+	release, err := tr.Acquire(email, func() { closed.Add(1) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &closed, release
+}
+
+func TestResyncKeepsSessions(t *testing.T) {
+	tr := newTracker(30*time.Millisecond, 0)
+	closed, release := session(t, tr, "a")
+	defer release()
+	tr.Removed("a", testAccountStub("k1"))
+	tr.Added("a", testAccountStub("k1"))
+	time.Sleep(90 * time.Millisecond)
+	if closed.Load() != 0 {
+		t.Fatal("unchanged user lost its session")
+	}
+}
+
+func TestRemovalClosesAfterGrace(t *testing.T) {
+	tr := newTracker(20*time.Millisecond, 0)
+	closed, release := session(t, tr, "b")
+	defer release()
+	tr.Removed("b", testAccountStub("k1"))
+	if closed.Load() != 0 {
+		t.Fatal("closed before grace")
+	}
+	deadline := time.Now().Add(2 * time.Second)
+	for closed.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if closed.Load() != 1 {
+		t.Fatalf("closed %d times", closed.Load())
+	}
+}
+
+func TestNewKeyClosesAtOnce(t *testing.T) {
+	tr := newTracker(time.Hour, 0)
+	closed, release := session(t, tr, "c")
+	defer release()
+	tr.Removed("c", testAccountStub("old"))
+	tr.Added("c", testAccountStub("new"))
+	if closed.Load() != 1 {
+		t.Fatal("old key kept its session")
+	}
+}
+
+func TestGraceZeroNeverCloses(t *testing.T) {
+	tr := newTracker(0, 0)
+	var closed atomic.Int32
+	release, err := tr.Acquire("d", func() { closed.Add(1) })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	tr.Removed("d", nil)
+	if len(tr.pending) != 0 || closed.Load() != 0 {
+		t.Fatal("disabled tracker acted")
+	}
+}
+
+func TestConnLimitSpansTrackers(t *testing.T) {
+	a, b := newTracker(0, 2), newTracker(0, 2)
+	r1, err := a.Acquire("e", func() {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r2, err := b.Acquire("e", func() {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := a.Acquire("e", func() {}); err != ErrTooManyConns {
+		t.Fatalf("got %v", err)
+	}
+	r1()
+	r3, err := a.Acquire("e", func() {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	r2()
+	r3()
+	conns.Lock()
+	defer conns.Unlock()
+	if _, ok := conns.n["e"]; ok {
+		t.Fatal("count leaked")
+	}
+}
+
+func TestBucketPaces(t *testing.T) {
+	b := NewBucket(1 << 20)
+	start := time.Now()
+	b.tokens = 0
+	if d := b.reserve(start, 1<<19); d < 400*time.Millisecond || d > 600*time.Millisecond {
+		t.Fatalf("owed %v for half a second of data", d)
+	}
+	if d := b.reserve(start.Add(time.Second), 1); d <= 0 {
+		// the debt of half a second is repaid and half a second of refill remains
+		return
+	}
+	t.Fatal("debt not repaid")
+}
+
+func TestBucketWaitStopsWithContext(t *testing.T) {
+	b := NewBucket(1)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if err := b.Wait(ctx, 1<<30); err == nil {
+		t.Fatal("wait ignored cancelled context")
+	}
+}
