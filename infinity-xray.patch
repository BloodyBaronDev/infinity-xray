+package icusers
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestUnlimitedListSkipsBuckets(t *testing.T) {
+	dir := t.TempDir()
+	freePath, unlimPath := filepath.Join(dir, "free.txt"), filepath.Join(dir, "unlimited.txt")
+	os.WriteFile(freePath, []byte("7\n"), 0o644)
+	os.WriteFile(unlimPath, []byte("# без лимита\n42\n7\n"), 0o644)
+
+	oldFree, oldList, oldUnlim, oldDown, oldUp := rateFree, freeUsers, unlimitedUsers, rateDown, rateUp
+	defer func() { rateFree, freeUsers, unlimitedUsers, rateDown, rateUp = oldFree, oldList, oldUnlim, oldDown, oldUp }()
+	rateFree, rateDown, rateUp = 5e6/8, 13e6/8, 13e6/8
+	freeUsers, unlimitedUsers = newFreeList(freePath), newUserList(unlimPath, "unlimited users")
+
+	if DownlinkBucket("42") != nil || UplinkBucket("42") != nil {
+		t.Fatal("ключ без лимита получил ведро")
+	}
+	if DownlinkBucket("7") != nil {
+		t.Fatal("список без лимита должен быть важнее списка бесплатных")
+	}
+	if b := DownlinkBucket("100"); b == nil || b.rate != 13e6/8 {
+		t.Fatal("обычный платный потерял общий лимит")
+	}
+	// Ключ убрали из списка: новые соединения снова с лимитом.
+	os.WriteFile(unlimPath, []byte("7\n"), 0o644)
+	future := time.Now().Add(time.Minute)
+	os.Chtimes(unlimPath, future, future)
+	unlimitedUsers.reload(time.Time{}, -1)
+	if b := DownlinkBucket("42"); b == nil || b.rate != 13e6/8 {
+		t.Fatal("после удаления из списка лимит не вернулся")
+	}
+	var none *freeList
+	if none.has("42") {
+		t.Fatal("nil-список не пуст")
+	}
+}
