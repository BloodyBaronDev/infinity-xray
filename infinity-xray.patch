diff --git a/transport/internet/tls/certificate_store.go b/transport/internet/tls/certificate_store.go
new file mode 100644
index 0000000..797253c
--- /dev/null
+++ b/transport/internet/tls/certificate_store.go
@@ -0,0 +1,91 @@
+package tls
+
+import (
+	"bytes"
+	"crypto/tls"
+	"crypto/x509"
+	"fmt"
+	"sync"
+	"sync/atomic"
+
+	"github.com/xtls/xray-core/common/platform/filesystem"
+	"google.golang.org/protobuf/proto"
+)
+
+// Опубликованный снимок не меняется: handshake может держать его после reload.
+type certificateSource struct {
+	current atomic.Pointer[Certificate]
+	stop    chan struct{}
+	once    sync.Once
+}
+
+func newCertificateSource(entry *Certificate) *certificateSource {
+	source := &certificateSource{stop: make(chan struct{})}
+	source.current.Store(proto.Clone(entry).(*Certificate))
+	return source
+}
+
+func (s *certificateSource) load() *Certificate { return s.current.Load() }
+
+func (s *certificateSource) close() { s.once.Do(func() { close(s.stop) }) }
+
+func (s *certificateSource) reload() (bool, error) {
+	previous := s.load()
+	if previous.CertificatePath == "" || previous.KeyPath == "" {
+		return false, nil
+	}
+	certificate, err := filesystem.ReadCert(previous.CertificatePath)
+	if err != nil {
+		return false, err
+	}
+	key, err := filesystem.ReadCert(previous.KeyPath)
+	if err != nil {
+		return false, err
+	}
+	if bytes.Equal(certificate, previous.Certificate) && bytes.Equal(key, previous.Key) {
+		return false, nil
+	}
+	// Во время замены двух файлов может временно появиться несовпадающая пара.
+	if _, err := tls.X509KeyPair(certificate, key); err != nil {
+		return false, fmt.Errorf("invalid reloaded certificate pair: %w", err)
+	}
+	next := proto.Clone(previous).(*Certificate)
+	next.Certificate, next.Key = certificate, key
+	s.current.Store(next)
+	return true, nil
+}
+
+type certificateStore struct {
+	entries []*atomic.Pointer[tls.Certificate]
+	sources []*certificateSource
+}
+
+func (s *certificateStore) add(certificate *tls.Certificate, source *certificateSource) *atomic.Pointer[tls.Certificate] {
+	entry := new(atomic.Pointer[tls.Certificate])
+	entry.Store(certificate)
+	s.entries = append(s.entries, entry)
+	s.sources = append(s.sources, source)
+	return entry
+}
+
+func (s *certificateStore) snapshot() []*tls.Certificate {
+	certificates := make([]*tls.Certificate, len(s.entries))
+	for index, entry := range s.entries {
+		certificates[index] = entry.Load()
+	}
+	return certificates
+}
+
+func (s *certificateStore) close() {
+	for _, source := range s.sources {
+		source.close()
+	}
+}
+
+func clonePublishedCertificate(certificate *tls.Certificate) *tls.Certificate {
+	copy := *certificate
+	if copy.Leaf == nil && len(copy.Certificate) > 0 {
+		copy.Leaf, _ = x509.ParseCertificate(copy.Certificate[0])
+	}
+	return &copy
+}
